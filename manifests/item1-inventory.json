    "rtl/gen/__main__.py",
    "rtl/gen/emit.py",
    "rtl/gen/params.py",
    "rtl/regen.sh",
    "rtl/params/fft256.params",
    "rtl/wrapper/fft256_stream.sv",
    "synth/fft256.synth.json"
  ],
  "derived": [
