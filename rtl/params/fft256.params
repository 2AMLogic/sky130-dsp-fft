# 256-point radix-2^2 SDF parameters (schema: rtl/README.md).
# stage_widths and twiddle_width are PLACEHOLDERS until the model study (#31)
# selects them; no accuracy or overflow claim is made by these values.
size=256
architecture=r22sdf
direction=forward
input_width=16
output_width=16
stage_widths=17,18,19,20,21,22,23,24
twiddle_width=16
complex_mult=3mult
rounding=convergent
output_order=natural
pipeline=1
stall=1
